node_modules/
dist/
build/
.next/
.expo/
.expo-export-test/
out/
coverage/

.env
.env.*
!.env.example
supabase/functions/.env.local

# The local Edge Function environment is **committed** on purpose: it carries
# no credential, and CI runs `supabase start` with no developer override, so
# the password-reset probe needs a mail transport that exists without anyone
# writing one by hand. The gitignored `.env.local` is the developer override.
!supabase/functions/.env

*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

.DS_Store
Thumbs.db

*.tsbuildinfo
*.tgz
.vercel/
.idea/
.vscode/*
!.vscode/extensions.json

# EAS build artefacts and the local credentials directory. `eas.json` itself
# is committed — the *profiles* are the contract — but the per-project
# credentials and the build output are not.
.eas/

# Local scratch — captured console output, one-off notes, ad-hoc probes.
# The real harnesses live in tools/ and are tracked deliberately.
tmp-*
*.tmp
scratch/

# Supabase CLI scratch: generated keys, pre-reset backups, cron probes.
supabase/.temp/


tools/cloudflared/cloudflared.exe

# The EAS build profile holds the Supabase and map keys. Copy `eas.example.json`
# to `eas.json` and fill them in. It is never committed.
apps/mobile/eas.json
