# Nagar Shield — moderator console environment
#
# Both variables are PUBLIC by design: they ship in the browser bundle and
# are protected by Row Level Security. The service-role key is deliberately
# absent from this file and from this package — it lives only in the Edge
# Functions and in CI secrets.

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
