# Nagar Shield — mobile app environment
#
# Every variable here is PUBLIC by design. The `EXPO_PUBLIC_` prefix is what
# tells Expo to inline the value into the JS bundle, so these ship to every
# device that installs the app.
#
# They are safe to ship because the anon (publishable) key is scoped by Row
# Level Security, not by secrecy — a client that reads a row it must not
# read is stopped by the database, not by the key.
#
# The **service-role key is deliberately absent** — from this file, from
# `.env.example`, and from every EAS profile. It lives only in the Edge
# Functions and in the CI Environment secrets. See
# `docs/operations/secrets.md`.

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon (publishable) key
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The SMS OTP path. Always false in Phase 1 — no provider is funded
# (FR-DATA-5 / waiver W-2). Every EAS profile asserts the same value.
EXPO_PUBLIC_SMS_OTP_ENABLED=false

# The API host the certificate pinning applies to. Only the production
# profile sets it, and only the production profile pins.
# EXPO_PUBLIC_API_HOST=

# The certificate pin set — a comma-separated list of base64 SHA-256
# subject-public-key digests. A digest may carry the `sha256/` prefix; a
# bare digest gets it. A backup pin is always present.
# EXPO_PUBLIC_CERT_PIN_PUBLIC_KEYS=
